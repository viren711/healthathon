# Copy to .env and edit. The app reads these at startup.

# OpenAI-compatible endpoint of your local model server.
# Started by scripts/serve_llm.sh (llama.cpp on CPU), or point at any
# vLLM / TGI / Ollama / hosted host that speaks /v1/chat/completions.
LLM_BASE_URL=http://localhost:8000/v1

# Must match the --alias that scripts/serve_llm.sh passes to llama-server.
LLM_MODEL=qwen2.5-3b-instruct

# llama.cpp ignores the key, but the header must be present.
LLM_API_KEY=not-needed

# Scite Assistant API. Keep this server-side; do not expose it in the browser.
# SCITE_API_KEY=
# SCITE_API_BASE_URL=https://api.scite.ai
# SCITE_TIMEOUT_SECONDS=120
# SCITE_POLL_INTERVAL_SECONDS=1

# Optional MCP fallback. It uses the JSON-RPC literature search tool and MCP credits.
# SCITE_MCP_API_KEY=
# SCITE_MCP_BASE_URL=https://api.scite.ai

# Sarvam AI: voice input, Indian languages and read-aloud in the Patient Portal
# and the Knowledge Assistant (docs/voice.md). Server-side only. Without it
# both pages are typed English, as before.
# SARVAM_API_KEY=

# Optional: override the sampling temperature from config/rag.yaml.
# LLM_TEMPERATURE=0.1

# Spare keys (optional). Tried in this order; a key that is out of credit/quota
# is skipped from then on (remembered in artifacts/key_state.json).
#   Sarvam: SARVAM_API_KEY_coiffeur, SARVAM_API_KEY, SARVAM_API_KEY_1, SARVAM_API_KEY_2
#   Scite:  SCITE_API_KEY, extra_scite_api  (and extra_scite_api after SCITE_MCP_API_KEY)
# SARVAM_API_KEY_1=
# SARVAM_API_KEY_2=
# SARVAM_API_KEY_coiffeur=
# extra_scite_api=
